text"}]}, {"content": "secondary_1", "type": "objective"}], "id": 0}, {"responses": [{"correct": 1, "_data": [{"content": "\u00c0 quoi sont ces tartelettes-ci ?", "type": "text"}], "selected": 0, "id": 0}, {"text": "", "correct": 0, "_data": [{"content": "Pourquoi ne pas assister \u00e0 un cours de p\u00e2tisserie ?", "type": "text"}], "selected": 0, "id": 1}, {"text": "", "correct": false, "_data": [{"content": "Est-ce qu'il vous reste des \u00e9clairs ?", "type": "text"}], "selected": 0, "id": 2}, {"text": "", "correct": true, "_data": [{"content": "Quand donnez-vous ces cours ?", "type": "text"}], "selected": 0, "id": 3}], "_data": [{"type": "question", "contents": [{"content": "Que demande Coraline ?", "type": "text"}]}, {"content": "secondary_1", "type": "objective"}], "id": 1}, {"responses": [{"correct": 1, "_data": [{"content": "O\u00f9 est-ce qu'on s'assoit ?", "type": "text"}], "selected": 0, "id": 0}, {"text": "", "correct": 0, "_data": [{"content": "Est-ce qu'ils sortent tout juste du four ?", "type": "text"}], "selected": 0, "id": 1}, {"text": "", "correct": 0, "_data": [{"content": "Qui pr\u00e9pare ces tartelettes ?", "type": "text"}], "selected": 0, "id": 2}, {"text": "", "correct": true, "_data": [{"content": "Qu'est-ce qui vous reste ?", "type": "text"}], "selected": 0, "id": 3}], "_data": [{"type": "question", "contents": [{"content": "Que demande Tante Eug\u00e9nie ?", "type": "text"}]}, {"content": "secondary_1", "type": "objective"}], "id": 2}], "type": "MMM", "id": 2, "stimuli_ids": []}, {"template_override": 1, "_data": [{"type": "instructions", "contents": [{"content": "Le p\u00e2tissier donne quelques suggestions \u00e0 Coraline.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Activity 2", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "correct_feedback": "Vous avez fini !", "attempt_feedback": [{"content": "", "type": "te